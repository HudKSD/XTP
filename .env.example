APP_NAME=LidarKinesis IntelChat
APP_PORT=8000
APP_DEBUG=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1400

ES_URL=http://localhost:9200
ES_DEFAULT_INDEX=news-*
ES_DEFAULT_TIME_FIELD=Timestamp
ES_ALLOWED_INDEX_PATTERNS=news-*,articles-*
ES_VERIFY_CERTS=false
ES_CA_CERTS=
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=

TOOL_TIMEOUT_SECONDS=45
TOOL_LOOP_MAX_ROUNDS=10
TOOL_REPEAT_LIMIT=2
TRANSCRIPT_MESSAGE_LIMIT=24
DATA_DIR=/app/data
SKILLS_ROOT=/app/skills
TRACE_ENABLED=true
MAX_MESSAGE_CHARS=12000
